[Unit]
Description=TPC-VModem shared network configuration
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vmodem
ExecStart=/bin/bash /opt/vmodem/vmodem-network.sh start
ExecStop=/bin/bash /opt/vmodem/vmodem-network.sh stop
LogNamespace=vmodem
