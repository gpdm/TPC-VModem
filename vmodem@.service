[Unit]
Description=TPC-VModem virtual Hayes modem on /dev/%I
Requires=pigpiod.service
Requires=vmodem-network.service
BindsTo=dev-%i.device
After=network.target pigpiod.service vmodem-network.service dev-%i.device

[Service]
Type=simple
WorkingDirectory=/opt/vmodem
ExecStart=/bin/bash /opt/vmodem/vmodem.sh %I
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
