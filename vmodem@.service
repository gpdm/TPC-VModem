[Unit]
Description=TPC-VModem virtual Hayes modem on /dev/%I
Requires=pigpiod.service
Requires=vmodem-network.service
Requires=vmodem-soundd.service
BindsTo=dev-%i.device
After=network.target pigpiod.service vmodem-network.service vmodem-soundd.service dev-%i.device

[Service]
Type=simple
WorkingDirectory=/opt/vmodem
#ExecStart=/bin/bash /opt/vmodem/vmodem.sh %I
# push vmodem into subshell
ExecStart=/bin/bash -c '/bin/bash /opt/vmodem/vmodem.sh "$1" & wait $!' _ %I
Restart=on-failure
RestartForceExitStatus=SIGHUP
RestartSec=5
StandardOutput=journal
StandardError=journal
LogNamespace=vmodem
