[Unit]
Description=TPC-VModem shared audio daemon

[Service]
Type=simple
WorkingDirectory=/opt/vmodem
RuntimeDirectory=vmodem
ExecStart=/usr/bin/python3 /opt/vmodem/vmodem-soundd.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LogNamespace=vmodem

[Install]
WantedBy=multi-user.target
