# Recreate only our table, atomically, even when it does not exist yet.
add table ip visp
delete table ip visp

table ip visp {
    set proxy_clients {
        type ipv4_addr
    }

    chain input {
        type filter hook input priority filter; policy accept;

        ip daddr 100.64.255.0/24 iifname "lo" accept
        iifname "ppp*" ip saddr 100.64.254.0/24 ip daddr 100.64.255.53 udp dport 53 accept
        iifname "ppp*" ip saddr 100.64.254.0/24 ip daddr 100.64.255.80 tcp dport 80 accept
        ip daddr 100.64.255.0/24 drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        ip saddr 100.64.255.0/24 drop
        ip daddr 100.64.255.0/24 drop
        iifname "visp0" drop
        oifname "visp0" drop
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        iifname "ppp*" ip saddr @proxy_clients \
            udp dport 53 dnat to 100.64.255.53:53

        iifname "ppp*" ip saddr @proxy_clients \
            tcp dport 80 dnat to 100.64.255.80:80
    }
}
