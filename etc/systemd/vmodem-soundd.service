[Unit]
Description=TPC-VModem shared audio daemon
StopWhenUnneeded=yes

[Service]
Type=simple
WorkingDirectory=/opt/vmodem/libexec
RuntimeDirectory=vmodem
ExecStart=/usr/bin/python3 /opt/vmodem/libexec/vmodem-soundd.py --daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LogNamespace=vmodem